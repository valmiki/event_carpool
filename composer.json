{
  "name": "valmiki/event_carpool",
  "type": "elgg-plugin",
  "description": "Adds carpool functionality to the Event Manager plugin for Elgg.",
  "version": "2.1.0",
  "keywords": ["elgg", "plugin", "carpool", "event"],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Jan Storms",
      "email": "post@janstorms.org",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "post@janstorms.org",
    "issues": "https://github.com/valmiki/event_carpool/issues",
    "source": "https://github.com/valmiki/event_carpool"
  },
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.0 || ^2.0",
    "elgg/elgg": "^6.3 || ^7.0",
    "coldtrick/event_manager": "^20.0 || ^21.0"
  },
  "autoload": {
    "psr-4": {
      "EventCarpool\\": "classes/EventCarpool/"
    }
  },
  "extra": {
    "installer-name": "event_carpool"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
